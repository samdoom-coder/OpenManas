VITE_API_URL=http://localhost:3001
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/nexus
JWT_SECRET=change-me-to-a-long-random-string
# Production hardening (see server/security.ts):
# Comma-separated frontend origins. Unset = allow all (dev only).
# CORS_ORIGIN=https://app.example.com
# Rate limits per IP per 15 min (general / auth / AI).
# RATE_LIMIT_GENERAL=1000
# RATE_LIMIT_AUTH=30
# RATE_LIMIT_AI=20
# Max file metadata size in MB.
# FILE_MAX_SIZE_MB=25
STORAGE_PROVIDER=local
# For prod, configure:
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
