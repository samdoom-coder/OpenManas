VITE_API_URL=http://localhost:3001
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/openmanas
# Generate with: openssl rand -base64 48
# Required in production (server refuses to boot with the default).
JWT_SECRET=change-me-to-a-long-random-string
# Optional: access-token lifetime (default 7d). e.g. 1d, 12h.
# JWT_EXPIRES_IN=7d
# Auth hardening:
# Production (NODE_ENV=production) fails closed: Bearer JWT required on all
# /api routes, passwordless demo-token accounts rejected, collab WS requires
# JWT. Set REQUIRE_AUTH=1 to get the same behavior in dev/staging.
# NODE_ENV=production
# REQUIRE_AUTH=1
# Production hardening (see server/security.ts):
# Comma-separated frontend origins. Unset = allow all (dev only).
# CORS_ORIGIN=https://app.example.com
# Rate limits per IP per 15 min (general / auth / AI).
# RATE_LIMIT_GENERAL=1000
# RATE_LIMIT_AUTH=30
# RATE_LIMIT_AI=20
# Max file metadata size in MB.
# FILE_MAX_SIZE_MB=25
# Realtime collaboration (Yjs): WS server port + URL the frontend connects to.
# Run with `npm run collab` (included in `npm run dev:all`).
COLLAB_PORT=3002
VITE_COLLAB_URL=ws://localhost:3002
# Production requires JWT on the WS by default. Legacy opt-out:
# COLLAB_REQUIRE_AUTH=1
# Emergency demo re-allow (not recommended):
# COLLAB_ALLOW_DEMO=1
STORAGE_PROVIDER=local
# For prod, configure:
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
