// Prisma schema — mirrors migrations/001 + 002s + 003_derived + 004_pgvector + 005_db_favorite.
// Runtime uses `pg` Pool (server/pg.ts) against the same tables so the app runs
// with or without `prisma generate`. Run `npx prisma db push` or
// `npm run db:migrate` (raw SQL) to provision Postgres, then set DATABASE_URL.
// NOTE (Prisma 7): datasource `url` lives in prisma.config.ts at the repo root,
// not here. Do not re-add `url = env(...)` — `prisma validate` fails with P1012.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  name         String
  avatar       String?
  passwordHash String?   @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("users")
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  icon      String?
  ownerId   String?  @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Page {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  title       String
  icon        String?
  cover       String?
  description String?
  properties  Json     @default("{}")
  theme       String?  @default("default")
  isFavorite  Boolean  @default(false) @map("is_favorite")
  isArchived  Boolean  @default(false) @map("is_archived")
  isTrashed   Boolean  @default(false) @map("is_trashed")
  isShared    Boolean  @default(false) @map("is_shared")
  shareMode   String?  @map("share_mode")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([workspaceId])
  @@index([parentId])
  @@index([updatedAt])
  @@map("pages")
}

model Block {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId     String   @map("page_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  type       String
  content    String?
  properties Json     @default("{}")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([pageId])
  @@index([position])
  @@map("blocks")
}

model Database {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  pageId      String?  @map("page_id") @db.Uuid
  name        String
  icon        String?
  description String?
  isFavorite  Boolean  @default(false) @map("is_favorite")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("databases")
}

model DatabaseProperty {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  databaseId         String  @map("database_id") @db.Uuid
  name               String
  type               String
  options            Json?
  relationDatabaseId String? @map("relation_database_id") @db.Uuid
  width              Int?
  visible            Boolean @default(true)

  @@index([databaseId])
  @@map("database_properties")
}

model DatabaseView {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  databaseId        String  @map("database_id") @db.Uuid
  name              String
  type              String
  filter            Json?
  sort              Json?
  groupBy           String? @map("group_by") @db.Uuid
  visibleProperties Json?   @map("visible_properties")

  @@index([databaseId])
  @@map("database_views")
}

model DatabaseRecord {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  databaseId String   @map("database_id") @db.Uuid
  properties Json     @default("{}")
  derived    Json     @default("{}")
  pageId     String?  @map("page_id") @db.Uuid
  position   Int?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([databaseId])
  @@map("database_records")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId    String?  @map("page_id") @db.Uuid
  blockId   String?  @map("block_id") @db.Uuid
  recordId  String?  @map("record_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  content   String?
  mentions  Json?
  resolved  Boolean  @default(false)
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([pageId])
  @@index([blockId])
  @@map("comments")
}

model File {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  filename    String?
  mimeType    String?  @map("mime_type")
  size        Int?
  storageKey  String?  @map("storage_key")
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId])
  @@map("files")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String?
  title     String?
  body      String?
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("notifications")
}

model Activity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String?
  targetId    String?  @map("target_id") @db.Uuid
  targetType  String?  @map("target_type")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@map("activities")
}

model PageVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId         String?  @map("page_id") @db.Uuid
  version        Int?
  blocksSnapshot Json?    @map("blocks_snapshot")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([pageId])
  @@map("page_versions")
}

// pgvector table (migrations/004_pgvector.sql). Raw SQL only — the vector(256)
// column has no Prisma native type, so it is opaque here. Dim must match
// EMBEDDING_DIM in src/lib/embeddings.ts.
model Embedding {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  embedding  Unsupported("vector(256)")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
  @@map("embeddings")
}
